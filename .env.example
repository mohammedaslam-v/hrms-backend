NODE_ENV=development
PORT=3000

# HRMS tables live in the same schema as `admins` so identity can be joined directly
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=bambinos_updated
DB_CONNECTION_LIMIT=10

# HRMS issues its own tokens with its own secret — never reuse admin-backend's JWT_SECRET.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Email over HTTPS (the prod host blocks SMTP). EMAIL_PROVIDER picks the sender:
#   ses       Amazon SES — the default. Same AWS account as faculty/admin.
#   postmark  Emergency switch: flip to this in Cloud Run if SES has a problem
#             (bounce review, account paused). No code change, no new deploy.
# Keep BOTH providers' credentials set so the switch works either way.
# With no credentials for the active provider the OTP is printed to the server
# console — development only.
EMAIL_PROVIDER=ses
MAIL_FROM=bconnect@bambinos.live
# Shown as the sender and used as the product name inside the OTP email.
MAIL_NAME=Bambinos Bconnect

# SES. Send-only IAM user (ses:SendEmail). Any @bambinos.live address works as
# MAIL_FROM because the domain identity is verified in this region.
SES_AWS_REGION=ap-southeast-2
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# Optional: configuration set that reports bounces/complaints.
SES_CONFIGURATION_SET=
# "source" tag on every SES email so a bounce says which backend sent it.
EMAIL_SOURCE=hrms

# Postmark server token — only used when EMAIL_PROVIDER=postmark.
POSTMARK_TOKEN=

CORS_ORIGIN=http://localhost:5173

# Encrypts salary figures in hrms_employee_compensation. REQUIRED — the server
# will not start without it. 32 random bytes, base64; generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Every environment gets its OWN key. Never commit one, never reuse the live key
# locally. Lose the live key and every live salary is unreadable for good, so a
# copy is kept in a password manager outside the server.
COMPENSATION_ENC_KEY=

# Shared with admin-backend (its HRMS_INTERNAL_API_KEY) for the admin panel's header
# Check in / Check out. Unset = the /internal routes refuse every request.
INTERNAL_API_KEY=
