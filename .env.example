NODE_ENV=development
PORT=3000

# HRMS tables live in the same schema as `admins` so identity can be joined directly
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=
DB_NAME=bambinos_updated
DB_CONNECTION_LIMIT=10

# HRMS issues its own tokens with its own secret — never reuse admin-backend's JWT_SECRET.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Postmark over HTTPS (admin-backend uses the same provider; the prod host blocks SMTP).
# With no token the OTP is printed to the server console — development only.
POSTMARK_TOKEN=
EMAIL_FROM=
MAIL_NAME=Bambinos HRMS

CORS_ORIGIN=http://localhost:5173

# WhatsApp via Heltar. With HELTAR_ENABLED=false the message is logged, not sent.
HELTAR_API_KEY=
HELTAR_ENABLED=true
